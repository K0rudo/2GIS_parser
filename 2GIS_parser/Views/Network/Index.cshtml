const nodeColors = { hub:'#DE2028', switch:'#3B455E', client:'#59A8DD' };
const nodeLabels = { hub:'Главный узел (АТС)', switch:'Коммутационный узел', client:'Клиентский узел' };

const map = new mapgl.Map('map', {
    center: [104.295, 52.270],
    zoom: 12,
    key: API_KEY
});

// Рисуем линии по дорогам
function drawRoutes() {
    for (const link of links) {
        const coords = link.waypoints;
        const color  = link.type === 'fiber' ? '#DE2028' : '#1d6ae5';
        const width  = link.type === 'fiber' ? 3 : 2;
        try {
            new mapgl.Polyline(map, { coordinates: coords, color, width, opacity: 0.8 });
        } catch(e) {
            coords.forEach((c, i) => {
                if (i % 3 !== 0) return;
                new mapgl.HtmlMarker(map, {
                    coordinates: c,
                    html: `<div style="width:4px;height:4px;border-radius:50%;background:${color};opacity:0.75"></div>`,
                    anchor: [2, 2]
                });
            });
        }
    }
    document.getElementById('loading').style.display = 'none';
}

// Рисуем маркеры узлов
nodes.forEach(node => {
    const color = nodeColors[node.type];
    const size  = node.type === 'hub' ? 18 : node.type === 'switch' ? 14 : 12;
    const opacity = node.active ? 1 : 0.4;

    const marker = new mapgl.HtmlMarker(map, {
        coordinates: [node.lon, node.lat],
        html: `<div onclick="showPopupByNode(${node.id})"
            style="width:${size}px;height:${size}px;border-radius:50%;
                   background:${color};border:2px solid white;
                   box-shadow:0 2px 6px rgba(0,0,0,0.3);cursor:pointer;
                   opacity:${opacity};transition:transform 0.15s"
            onmouseover="this.style.transform='scale(1.3)'"
            onmouseout="this.style.transform='scale(1)'">
        </div>`,
        anchor: [size/2, size/2]
    });
});

map.on('click', closePopup);
drawRoutes();
// Боковая панель
const list = document.getElementById('nodes-list');
nodes.forEach(node => {
    const item = document.createElement('div');
    item.className = 'node-item';
    item.id = 'node-item-' + node.id;
    item.innerHTML = `
        <div class="node-dot dot-${node.type}"></div>
        <div>
            <div class="node-name">${node.name}</div>
            <div class="node-type">${nodeLabels[node.type]}${!node.active ? ' · Неактивен' : ''}</div>
        </div>`;
    item.onclick = () => {
        map.setCenter([node.lon, node.lat]);
        map.setZoom(15);
        showPopupByNode(node.id);
        document.querySelectorAll('.node-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
    };
    list.appendChild(item);
});

function showPopupByNode(nodeId) {
    const node = nodes.find(n => n.id === nodeId);
    if (!node) return;
    document.getElementById('popup-name').textContent        = node.name;
    document.getElementById('popup-type').textContent        = nodeLabels[node.type];
    document.getElementById('popup-address').textContent     = node.address;
    document.getElementById('popup-hardware').textContent    = node.hardware;
    document.getElementById('popup-connections').textContent = node.connections + ' соединений';
    document.getElementById('popup-status').textContent = node.active ? 'Активен' : 'Неактивен';
    document.getElementById('node-popup').style.display = 'block';
    document.querySelectorAll('.node-item').forEach(i => i.classList.remove('active'));
    const item = document.getElementById('node-item-' + node.id);
    if (item) item.classList.add('active');
}

function closePopup() {
    document.getElementById('node-popup').style.display = 'none';
    document.querySelectorAll('.node-item').forEach(i => i.classList.remove('active'));
}
</script>
