@{
    ViewData["Title"] = "Аналитика";
    ViewData["Page"] = "analytics";

    var totalOrgs = (int)(ViewBag.TotalOrgs ?? 0);
    var totalJobs = (int)(ViewBag.TotalJobs ?? 0);
    var orgsWithContacts = (int)(ViewBag.OrgsWithContacts ?? 0);
    var avgRating = (double)(ViewBag.AvgRating ?? 0.0);
    var contactCoverage = totalOrgs > 0 ? (int)((double)orgsWithContacts / totalOrgs * 100) : 0;
}

<style>
    .analytics-hero {
        background: linear-gradient(135deg, #3B455E 0%, #81414D 50%, #DE2028 100%);
        padding: 28px 28px;
        color: white;
    }

    .analytics-hero h2 {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0;
    }

    .analytics-body {
        padding: 24px;
        background: #f0f3f8;
        min-height: calc(100vh - 68px - 80px);
    }

    /* Метрики */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .metric-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(59,69,94,0.08);
        text-align: center;
    }

    .metric-value {
        font-size: 2rem;
        font-weight: 700;
        color: #DE2028;
        line-height: 1;
        margin-bottom: 6px;
    }

    .metric-label {
        font-size: 0.78rem;
        color: #64748b;
        font-weight: 500;
    }

    /* Секции */
    .analytics-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    .analytics-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(59,69,94,0.08);
    }

    .analytics-card h3 {
        font-size: 0.85rem;
        font-weight: 700;
        color: #1a2236;
        margin: 0 0 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #f0f4f8;
    }

    /* Бар */
    .bar-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        font-size: 0.8rem;
    }

    .bar-label {
        width: 160px;
        color: #334155;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex-shrink: 0;
    }

    .bar-track {
        flex: 1;
        background: #f0f4f8;
        border-radius: 6px;
        height: 8px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #DE2028, #81414D);
        border-radius: 6px;
    }

    .bar-count {
        color: #64748b;
        font-weight: 600;
        width: 28px;
        text-align: right;
        flex-shrink: 0;
    }

    /* История поисков */
    .jobs-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
    }

    .jobs-table th {
        text-align: left;
        padding: 6px 8px;
        color: #94a3b8;
        font-weight: 600;
        font-size: 0.72rem;
        text-transform: uppercase;
        border-bottom: 1px solid #f0f4f8;
    }

    .jobs-table td {
        padding: 8px;
        color: #334155;
        border-bottom: 1px solid #f8fafc;
    }

    .jobs-table tr:last-child td {
        border-bottom: none;
    }

    .status-badge {
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .status-Completed { background: rgba(34,197,94,0.12); color: #16a34a; }
    .status-Running   { background: rgba(251,191,36,0.12); color: #d97706; }
    .status-Failed    { background: rgba(239,68,68,0.12);  color: #dc2626; }

    /* Прогресс-бар покрытия */
    .coverage-bar {
        background: #f0f4f8;
        border-radius: 8px;
        height: 12px;
        overflow: hidden;
        margin-top: 8px;
    }

    .coverage-fill {
        height: 100%;
        background: linear-gradient(90deg, #16a34a, #22c55e);
        border-radius: 8px;
        transition: width 0.5s;
    }

    /* Экспорт */
    .export-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(59,69,94,0.08);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .export-card h3 {
        font-size: 0.9rem;
        font-weight: 700;
        color: #1a2236;
        margin: 0 0 4px;
    }

    .export-card p {
        font-size: 0.8rem;
        color: #64748b;
        margin: 0;
    }

    .btn-export {
        background: #DE2028;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 0.83rem;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.18s;
    }

    .btn-export:hover {
        background: #b51920;
        color: white;
        text-decoration: none;
    }
</style>

<!-- Hero -->
<div class="analytics-hero">
    <h2>📊 Аналитика и отчёты</h2>
</div>

<div class="analytics-body">

    <!-- Метрики -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-value">@totalOrgs</div>
            <div class="metric-label">Организаций в базе</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">@totalJobs</div>
            <div class="metric-label">Поисков выполнено</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">@avgRating.ToString("F1")</div>
            <div class="metric-label">Средний рейтинг</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">@contactCoverage%</div>
            <div class="metric-label">Организаций с контактами</div>
        </div>
    </div>

    <!-- Экспорт -->
    <div class="export-card">
        <div>
            <h3>📥 Экспорт данных</h3>
            <p>Выгрузить все организации из базы данных в формате CSV</p>
        </div>
        <a href="/Analytics/Export" class="btn-export">Скачать CSV</a>
    </div>

    <!-- Графики -->
    <div class="analytics-grid">

        <!-- Топ категорий -->
        <div class="analytics-card">
            <h3>🏷️ Топ категорий</h3>
            @{
                var topCats = ViewBag.TopCategories as System.Collections.IList;
                var maxCat = 1;
                if (topCats != null && topCats.Count > 0)
                {
                    foreach (var item in topCats)
                    {
                        var cnt = (int)item.GetType().GetProperty("Count").GetValue(item);
                        if (cnt > maxCat) maxCat = cnt;
                    }
                }
            }
            @if (topCats != null && topCats.Count > 0)
            {
                foreach (var item in topCats)
                {
                    var cat   = (string?)item.GetType().GetProperty("Category").GetValue(item) ?? "—";
                    var count = (int)item.GetType().GetProperty("Count").GetValue(item);
                    var pct   = (int)((double)count / maxCat * 100);
                    <div class="bar-row">
                        <div class="bar-label" title="@cat">@cat</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width:@pct%"></div>
                        </div>
                        <div class="bar-count">@count</div>
                    </div>
                }
            }
            else
            {
                <p style="color:#94a3b8;font-size:0.82rem">Нет данных</p>
            }
        </div>

        <!-- По районам -->
        <div class="analytics-card">
            <h3>🏙️ По районам</h3>
            @{
                var byDistrict = ViewBag.ByDistrict as System.Collections.IList;
                var maxDist = 1;
                if (byDistrict != null && byDistrict.Count > 0)
                {
                    foreach (var item in byDistrict)
                    {
                        var cnt = (int)item.GetType().GetProperty("Count").GetValue(item);
                        if (cnt > maxDist) maxDist = cnt;
                    }
                }
            }
            @if (byDistrict != null && byDistrict.Count > 0)
            {
                foreach (var item in byDistrict)
                {
                    var dist  = (string?)item.GetType().GetProperty("District").GetValue(item) ?? "—";
                    var count = (int)item.GetType().GetProperty("Count").GetValue(item);
                    var pct   = (int)((double)count / maxDist * 100);
                    <div class="bar-row">
                        <div class="bar-label" title="@dist">@dist</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width:@pct%"></div>
                        </div>
                        <div class="bar-count">@count</div>
                    </div>
                }
            }
            else
            {
                <p style="color:#94a3b8;font-size:0.82rem">Нет данных</p>
            }
        </div>

    </div>

    <!-- Покрытие контактами -->
    <div class="analytics-card" style="margin-bottom:16px">
        <h3>📇 Покрытие контактами</h3>
        <div style="font-size:0.83rem;color:#475569;margin-bottom:6px">
            @orgsWithContacts из @totalOrgs организаций имеют контакты (@contactCoverage%)
        </div>
        <div class="coverage-bar">
            <div class="coverage-fill" style="width:@contactCoverage%"></div>
        </div>
    </div>

</div>
